          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(lodia_controlplane_datastore_members{namespace=\"$namespace\",controlplane=\"$controlplane\"})",
          "legendFormat": "members",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(lodia_controlplane_datastore_members_ready{namespace=\"$namespace\",controlplane=\"$controlplane\"})",
          "legendFormat": "ready",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
