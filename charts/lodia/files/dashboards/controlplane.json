      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (component) (lodia_controlplane_component_replicas{namespace=\"$namespace\",controlplane=\"$controlplane\"})",
          "legendFormat": "{{component}} wanted",
          "refId": "A",
          "range": true
