        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (component) (lodia_controlplane_component_replicas_ready{namespace=\"$namespace\",controlplane=\"$controlplane\"})",
          "legendFormat": "{{component}} ready",
          "refId": "B",
          "range": true
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 12,
        "w": 10,
        "x": 14,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "etcd members",
      "description": "Members the etcd asks for, those that are ready and those that run its current spec.",
