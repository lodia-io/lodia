{
  "uid": "lodia-controlplane",
  "title": "Lodia / Control plane",
  "description": "One ControlPlane chosen by the namespace and controlplane variables: its conditions, replicas, etcd, nodes and certificates.",
  "tags": [
    "lodia"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(lodia_controlplane_info, namespace)",
        "query": {
          "query": "label_values(lodia_controlplane_info, namespace)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "regex": "",
        "current": {}
      },
      {
        "name": "controlplane",
        "label": "Control plane",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(lodia_controlplane_info{namespace=\"$namespace\"}, controlplane)",
        "query": {
          "query": "label_values(lodia_controlplane_info{namespace=\"$namespace\"}, controlplane)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "regex": "",
        "current": {}
      },
      {
        "name": "holdFraction",
        "label": "Hold fraction",
        "type": "textbox",
        "query": "0.6",
        "current": {
          "selected": false,
          "text": "0.6",
          "value": "0.6"
        },
        "hide": 0,
        "options": [
          {
            "selected": true,
            "text": "0.6",
            "value": "0.6"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ready",
      "description": "The reason of the Ready condition, green while the condition is True.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "name",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (reason) (lodia_controlplane_condition_reason{type=\"Ready\",namespace=\"$namespace\",controlplane=\"$controlplane\"}) * on () group_left () max(lodia_controlplane_condition{type=\"Ready\",status=\"True\",namespace=\"$namespace\",controlplane=\"$controlplane\"})",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "range": true
        }
      ],
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Cluster",
      "description": "status.kubernetes.version, spec.layout, the datastore and the endpoint mode.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "name",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (kubernetes_version, layout, datastore, endpoint_mode) (lodia_controlplane_info{namespace=\"$namespace\",controlplane=\"$controlplane\"})",
          "legendFormat": "{{kubernetes_version}} / {{layout}} / {{datastore}} / {{endpoint_mode}}",
          "refId": "A",
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 6,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Earliest certificate expiry",
      "description": "Time until the earliest certificate PKI holds for the ControlPlane expires; LodiaCertificateExpiring fires within 14 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1209600
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max(lodia_controlplane_certificates_expiration_timestamp_seconds{namespace=\"$namespace\",controlplane=\"$controlplane\"}) - time()",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 14,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Slot and upgrade",
      "description": "How long the ControlPlane has held a maintenance slot, and how long its Kubernetes upgrade has run at its step.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "time() - max(lodia_controlplane_maintenance_slot_since_timestamp_seconds{namespace=\"$namespace\",controlplane=\"$controlplane\"})",
          "legendFormat": "slot held for",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "time() - max by (step) (lodia_controlplane_upgrade_started_timestamp_seconds{namespace=\"$namespace\",controlplane=\"$controlplane\"})",
          "legendFormat": "upgrade at {{step}} for",
          "refId": "B",
          "range": true
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "table",
      "title": "Conditions and since when",
      "description": "Each condition's status and reason, and how long it has had them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "displayName",
                "value": "Since"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "True": {
                        "color": "green",
                        "index": 0
                      },
                      "False": {
                        "color": "red",
                        "index": 1
                      },
                      "Unknown": {
                        "color": "orange",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "type",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "type": 0,
              "status": 1,
              "reason": 2,
              "Value": 3
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(time() - max by (type) (lodia_controlplane_condition_last_transition_timestamp_seconds{namespace=\"$namespace\",controlplane=\"$controlplane\"})) * on (type) group_left (reason) max by (type, reason) (lodia_controlplane_condition_reason{namespace=\"$namespace\",controlplane=\"$controlplane\"}) * on (type) group_left (status) max by (type, status) (lodia_controlplane_condition{namespace=\"$namespace\",controlplane=\"$controlplane\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 12,
        "w": 14,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Replicas of the API server, controller manager and scheduler",
      "description": "Replicas each component's Deployment asks for and those that are ready.",
      "datasource": {
        "type": "prometheus",
